# Host UID/GID — match your local user to avoid volume permission issues
# Run: id -u && id -g
USER_UID=1000
USER_GID=1000

# Paperclip
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# Optional: register an external hostname/IP with Paperclip
# IP_ADDRESS=192.168.1.100

# Hermes — Anthropic API key (needed to use Hermes, not required to start)
ANTHROPIC_API_KEY=

# Hermes gateway API server key — required for gateway mode (min 8 characters)
API_SERVER_KEY=changeme1

# Optional: override the Hermes model and provider
# HERMES_MODEL=anthropic/claude-sonnet-4-20250514
# HERMES_INFERENCE_PROVIDER=anthropic

# Hermes WebUI — local workspace directory mounted into the webui container
HERMES_WORKSPACE=~/workspace
