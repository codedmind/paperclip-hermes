# Host UID/GID — match your local user to avoid volume permission issues
# Run: id -u && id -g
USER_UID=1000
USER_GID=1000

# Paperclip
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# Required for authenticated mode — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL used for bootstrap invite links and Better Auth callbacks.
# CRITICAL: this URL must EXACTLY match what users type in the browser (scheme + host + port).
# Better Auth rejects sign-in/onboard from any other Origin — single value, no list support.
# Pick ONE canonical URL. If accessing from other machines on the LAN, replace `localhost` with
# the host's LAN IP (e.g. http://192.0.2.10:3100) in BOTH lines below AND in IP_ADDRESS.
# Trade-off: after switching to an IP, http://localhost:3100 will be rejected for new sign-ins
# (existing cookie sessions still work). For multi-origin access, put a reverse proxy in front.
PAPERCLIP_PUBLIC_URL=http://localhost:3100
BETTER_AUTH_URL=http://localhost:3100

# Register the host with Paperclip's allowed-hostname registry (separate check from Better Auth).
# Set to the same host as the URLs above when accessing over LAN. Leave commented for localhost-only.
# start.sh runs `paperclipai allowed-hostname $IP_ADDRESS` on every boot if set.
# IP_ADDRESS=your.lan.ip.here

# Hermes — Anthropic API key (needed to use Hermes, not required to start)
ANTHROPIC_API_KEY=

# Hermes gateway API server key — required for gateway mode (min 8 characters)
API_SERVER_KEY=changeme1

# Hermes model/provider config — consumido por envsubst em start.sh para renderizar
# /data/hermes/config.yaml a partir de hermes-config.yaml.template no boot.
# NOTA: Hermes não lê estas vars nativamente quando provider=custom; a substituição é feita
# pelo start.sh antes do Hermes arrancar. Mudar valor → docker compose down && up -d (sem rebuild).
HERMES_MODEL=qwen2.5-coder:32b
HERMES_PROVIDER=custom
HERMES_BASE_URL=http://remoteip:11434/v1
HERMES_CONTEXT_LENGTH=32768
HERMES_TERMINAL_BACKEND=local

# Hermes WebUI password — required when binding to 0.0.0.0 (set something strong)
HERMES_WEBUI_PASSWORD=

# Hermes WebUI — local workspace directory mounted into the webui container
# Must be an absolute path (e.g. /home/user/workspace). Tilde (~) is not expanded by Docker Compose.
HERMES_WORKSPACE=/workspace

# ─────────────────────────────────────────────────────────────────────────────
# Optional Hermes integrations
# ─────────────────────────────────────────────────────────────────────────────
# All vars below are optional — uncomment and fill only the ones you actually use.
# Reference: https://hermes-agent.nousresearch.com/docs/user-guide/docker#environment-variable-forwarding
#
# Scoping: only `paperclip-hermes` and `hermes-agent` load this file via `env_file:`.
# Any optional var below (provider keys, messaging tokens, search APIs, etc.) reaches both
# and is consumed wherever Hermes runs — local CLI in paperclip; Telegram/Slack/WhatsApp
# integrations in the gateway. Provider keys go on both because either can invoke an LLM.
#
# `hermes-dashboard` and `hermes-webui` do NOT load .env — they only read the explicit
# `environment:` block in docker-compose.yml. If one of them ever needs a var here, add it
# there explicitly (preserves least-privilege and makes the per-service surface auditable).

# ─── Additional LLM provider API keys (besides ANTHROPIC_API_KEY above) ──────
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# HF_TOKEN=
# OLLAMA_API_KEY=          # only for Ollama Cloud (ollama.com), not local Ollama
# OLLAMA_BASE_URL=         # only for Ollama Cloud overlay; local Ollama uses HERMES_BASE_URL above

# ─── Hermes API server / dashboard tuning ────────────────────────────────────
# API_SERVER_HOST=0.0.0.0
# API_SERVER_CORS_ORIGINS=*
# HERMES_DASHBOARD_HOST=0.0.0.0
# HERMES_DASHBOARD_PORT=9119
# HERMES_DASHBOARD_TUI=true

# ─── Search / web extraction (tool integrations) ─────────────────────────────
# FIRECRAWL_API_KEY=
# EXA_API_KEY=
# PARALLEL_API_KEY=
# TAVILY_API_KEY=

# ─── Messaging integrations (run inside the gateway) ─────────────────────────
# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=  # comma-separated user IDs
# TELEGRAM_WEBHOOK_URL=
#
# Slack
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USERS=     # comma-separated user IDs
#
# WhatsApp
# WHATSAPP_ENABLED=false
# WHATSAPP_ALLOWED_USERS=  # comma-separated phone numbers

# ─── Audio (STT / TTS) ───────────────────────────────────────────────────────
# VOICE_TOOLS_OPENAI_KEY=  # OpenAI Whisper + TTS (separate from OPENAI_API_KEY)
# GROQ_API_KEY=            # Groq free-tier STT

# ─── Browser automation / image generation ───────────────────────────────────
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# FAL_KEY=

# ─── Container permissions (advanced) ────────────────────────────────────────
# HERMES_ALLOW_ROOT_GATEWAY=false  # Allow gateway to run as root (not recommended)
